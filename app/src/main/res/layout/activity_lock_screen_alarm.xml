<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:colorBackground"
    android:padding="24dp">

    <!-- Top subtle label -->
    <TextView
        android:id="@+id/tv_alarm_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medication Reminder"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorSecondary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp" />

    <!-- Main alert card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_alarm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:layout_constraintTop_toBottomOf="@id/tv_alarm_label"
        app:layout_constraintBottom_toTopOf="@id/layout_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.42"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="28dp">

            <!-- Icon bubble -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSecondary">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="💊"
                    android:textSize="30sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Time -->
            <TextView
                android:id="@+id/tv_alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8:00 AM"
                android:textSize="38sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="20dp" />

            <!-- Medication name -->
            <TextView
                android:id="@+id/tv_med_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ibuprofen"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="10dp" />

            <!-- Dosage -->
            <TextView
                android:id="@+id/tv_dosage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200mg"
                android:textSize="16sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="4dp" />

            <!-- Optional extra details -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_extra_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/colorSecondary">

                <TextView
                    android:id="@+id/tv_extra_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 tablet • After breakfast"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSecondary"
                    android:paddingStart="14dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Instruction -->
            <TextView
                android:id="@+id/tv_instruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please confirm your action"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="18dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action buttons -->
    <LinearLayout
        android:id="@+id/layout_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="26dp">

        <Button
            android:id="@+id/btn_take_now"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Take Now"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:textSize="17sp"
            android:textColor="@android:color/white"
            android:background="@drawable/btn_fluent_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_snooze"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Snooze"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/btn_fluent_outlined" />

            <Button
                android:id="@+id/btn_miss"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Miss"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:textColor="?android:attr/textColorSecondary"
                android:background="@drawable/btn_fluent_outlined" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>