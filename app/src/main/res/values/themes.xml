<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.MedReminder" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary color -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_text_dark</item>

        <!-- Background / surfaces -->
        <item name="android:colorBackground">@color/md_light_bg</item>
        <item name="colorSurface">@color/md_light_bg</item>
        <item name="colorOnSurface">@color/md_text_dark</item>

        <!-- Optional extra polish -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/md_light_bg</item>
        <item name="android:navigationBarColor">@color/md_light_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.MedReminder" parent="Base.Theme.MedReminder" />
</resources>